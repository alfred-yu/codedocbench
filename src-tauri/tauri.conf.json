{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeDocBench",
  "version": "0.1.2",
  "identifier": "com.codedocbench.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run before:tauri:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeDocBench (Powered By 余绍健, v0.1.2)",
        "width": 960,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../python/dist": "backend_bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
